      "parameters": {
        "jsCode": "const meetingTitle =\n  $('On form submission').item.json.meeting_title || 'Untitled Meeting';\n\nconst actionItems =\n  $('Code in JavaScript').item.json.action_items || [];\n\nif (!Array.isArray(actionItems) || actionItems.length === 0) {\n  return [\n    {\n      json: {\n        meeting_title: meetingTitle,\n        task: 'No action items found',\n        owner: '',\n        deadline: '',\n        status: 'needs_clarification'\n      }\n    }\n  ];\n}\n\nreturn actionItems.map(item => ({\n  json: {\n    meeting_title: meetingTitle,\n    task: item.task || '',\n    owner: item.owner || 'Needs clarification',\n    deadline: item.deadline || 'Needs clarification',\n    status: item.status || 'needs_clarification'\n  }\n}));"
      },
